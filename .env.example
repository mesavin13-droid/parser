# Telegram: создайте бота через @BotFather. Никогда не публикуйте этот токен.
TELEGRAM_BOT_TOKEN=
# Сначала запустите "python main.py telegram" и отправьте /id боту.
TELEGRAM_CHAT_ID=

# Город для метки объявлений
SEARCH_CITY=Новосибирск

# URL разрешённых RSS/Atom источников — несколько URL через ;
RSS_FEEDS=

# URL публичного поиска Avito — несколько URL через ;
# Читает только публичную HTML-страницу, без логина и обхода защиты.
AVITO_SEARCH_URLS=

MIN_DISCOUNT_PERCENT=25
MIN_PROFIT_RUB=1500
MAX_RISK_SCORE=40
# Не отправлять объявления старше этого возраста (часы), даже если цена выглядит выгодной
MAX_LISTING_AGE_HOURS=72
# Не учитывать рыночные цены старше этого срока (дни)
MAX_MARKET_DATA_AGE_DAYS=30
DEFAULT_COMMISSION_PCT=0
POLL_INTERVAL_SECONDS=300
DEAL_DB_PATH=data/deals.sqlite3
